rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public content (read-only) ──────────────────────────────────
    match /resources/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /news/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /memories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /impact_stories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /audio_stories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /help_locations/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Public submissions — write only, NO public read ─────────────
    // Children submit anonymously; only authenticated admins can read
    match /incident_reports/{doc} {
      allow create: if true                          // submit anonymously
                    && request.resource.data.keys().hasOnly([
                         'situation','province','ageGroup','extra',
                         'language','timestamp','status','source',
                         'hasVoice','voiceUrl'
                       ])                            // only expected fields
                    && request.resource.data.status == 'new'; // can't self-mark resolved
      allow read, update, delete: if request.auth != null;   // admin only
    }
    match /newsletter/{doc} {
      allow create: if true
                    && request.resource.data.keys().hasOnly(['name','email','timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if request.auth != null;
    }
    match /referrals/{doc} {
      allow create: if true;                         // public referral submission
      allow read, update, delete: if request.auth != null; // admin only
    }

    // ── Admin-only collections ──────────────────────────────────────
    match /activity_log/{doc} {
      allow read, write: if request.auth != null;
    }
    match /admin_users/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
